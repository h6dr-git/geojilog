# 거지로그 환경변수 — 값은 .env에 넣고, .env는 커밋하지 않는다.

# 세션 쿠키 서명 비밀값 (필수)
JWT_SECRET=

# 데이터베이스 — 비우면 로컬 SQLite(local.db)
DATABASE_URL=
TURSO_AUTH_TOKEN=

# 사진 분석 — 비우면 AI 기능만 꺼진 채 동작
GEMINI_API_KEY=
# (선택) 쉼표 구분, 앞이 1차 모델. 기본 gemini-2.5-flash,gemini-2.5-flash-lite
LLM_MODELS=

# 카카오 로그인 — 비우면 로그인 기능 꺼짐
KAKAO_REST_API_KEY=
# 배포 주소 (카카오 리다이렉트·푸시 링크에 사용)
APP_BASE_URL=http://localhost:3000

# 웹 푸시 — 비우면 푸시 기능 숨김. `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 운영 계기판 /ops — 비우면 404
OPS_KEY=

# (선택) 업로드 폴더, 소유자 식별자
UPLOAD_DIR=uploads
OWNER_OPEN_ID=
